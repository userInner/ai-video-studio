ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ASSET_ROOT=./data/assets
SUB2API_BASE_URL=https://sub2api.aibro.vip/v1
SUB2API_API_KEY=
TEXT_MODEL=gpt-5.6-luna
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
IMAGE_TIMEOUT_SECONDS=360
MEDIA_QUALITY_MAX_RETRIES=1
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_API_KEY=
TTS_MODEL=speech-2.8-hd
TTS_VOICE_ID=Chinese (Mandarin)_Reliable_Executive
PREFER_LOCAL_QWEN_TTS=false
QWEN_TTS_PYTHON=/Users/yourname/miniconda3/envs/qwen3tts/bin/python
QWEN_TTS_CHECKPOINT=/Users/yourname/.cache/modelscope/models/Qwen--Qwen3-TTS-12Hz-1.7B-VoiceDesign/snapshots/master
QWEN_TTS_BASE_CHECKPOINT=/Users/yourname/.cache/modelscope/models/Qwen--Qwen3-TTS-12Hz-1.7B-Base/snapshots/master
QWEN_TTS_VOICE_REFERENCE=./data/voices/qwen-finance-narrator-v1.wav
QWEN_TTS_VOICE_DESIGN=成熟中性的中文女声，中低音，理性、干净、专业，像财经纪录片解说。语速自然，重点准确，克制但有判断力。
WHITEBOARD_RENDERER_ROOT=./vendor/srt-whiteboard-animation
ALLOW_NATIVE_TTS_FALLBACK=true
ALLOW_DEMO_FALLBACK=true
DIRECTOR_TIMEOUT_SECONDS=45
RESEARCH_TIMEOUT_SECONDS=120
RESEARCH_MAX_ATTEMPTS=3
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_BIND_ADDRESS=0.0.0.0
API_PORT=8010
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
